{{- if env "BW_SESSION" -}}
#!/bin/bash
# Secrets pass: write ~/.ssh/<name> from locker SSH key items ssh-key-<name>-<hostname>.
# Keys come from bw at run time; none are rendered into this script.
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
dir={{ printf "%s/.ssh" .chezmoi.destDir | quote }}
suffix={{ printf "-%s" .chezmoi.hostname | quote }}

mkdir -p "$dir"
chmod 700 "$dir"

bw list items --search ssh-key- | python3 -c '
import json, os, sys

directory, suffix = sys.argv[1], sys.argv[2]
prefix = "ssh-key-"

def write(path, content, mode):
    if os.path.exists(path) and open(path).read() == content:
        os.chmod(path, mode)
        return False
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.replace(path + ".tmp", path)
    os.chmod(path, mode)
    return True

written = 0
for item in json.load(sys.stdin):
    key = item.get("sshKey") or {}
    full = item["name"]
    if item.get("type") != 5 or not key.get("privateKey"):
        continue
    if not (full.startswith(prefix) and full.endswith(suffix)) or len(full) <= len(prefix) + len(suffix):
        continue
    name = full[len(prefix):-len(suffix)]
    path = os.path.join(directory, name)
    written += write(path, key["privateKey"].rstrip("\n") + "\n", 0o600)
    if key.get("publicKey"):
        write(path + ".pub", key["publicKey"].rstrip("\n") + "\n", 0o644)
print(f"ssh keys: {written} written")
' "$dir" "$suffix"
{{ end -}}
