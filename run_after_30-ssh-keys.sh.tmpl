{{- if env "BW_SESSION" -}}
#!/bin/bash
# Secrets pass: write ~/.ssh/<name> from locker SSH key items ssh-<hostname>-<name>.
# Keys come from bw at run time; none are rendered into this script.
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
dir={{ printf "%s/.ssh" .chezmoi.destDir | quote }}
prefix={{ printf "ssh-%s-" .chezmoi.hostname | quote }}

mkdir -p "$dir"
chmod 700 "$dir"

bw list items --search "$prefix" | python3 -c '
import json, os, sys

directory, prefix = sys.argv[1], sys.argv[2]

def write(path, content, mode):
    if os.path.exists(path) and open(path).read() == content:
        os.chmod(path, mode)
        return False
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.replace(path + ".tmp", path)
    os.chmod(path, mode)
    return True

written = 0
for item in json.load(sys.stdin):
    key = item.get("sshKey") or {}
    if item.get("type") != 5 or not item["name"].startswith(prefix) or not key.get("privateKey"):
        continue
    name = item["name"][len(prefix):]
    path = os.path.join(directory, name)
    written += write(path, key["privateKey"].rstrip("\n") + "\n", 0o600)
    if key.get("publicKey"):
        write(path + ".pub", key["publicKey"].rstrip("\n") + "\n", 0o644)
print(f"ssh keys: {written} written")
' "$dir" "$prefix"
{{ end -}}
