#!/bin/bash
# Reruns when packages.toml or mise config.toml changes.
# packages.toml: {{ include "dot_config/mise/packages.toml" | sha256sum }}
# config.toml: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}
mise install -y
mise exec -- bun "$HOME/.config/profile/packages.ts"

# Bitwarden CLI → self-hosted Vaultwarden. The server can only be set while logged out.
if mise exec -- bw status 2>/dev/null | grep -q '"status":"unauthenticated"'; then
  mise exec -- bw config server https://locker.jesseearle.com
fi
