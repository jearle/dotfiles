[alias]
	reauthor = commit --amend --no-edit --reset-author
	forcelease = push --force-with-lease
	pushu = push -u origin HEAD
	diffname = diff --name-only
	addcommit = "!f() { git add --all . && git commit -m \"$*\"; }; f"
	checkoutmainpull = !git checkout main && git pull
