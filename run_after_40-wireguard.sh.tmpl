{{- if env "BW_SESSION" -}}
#!/bin/bash
# Secrets pass: personal WireGuard tunnel from locker note wireguard-<hostname>.
# The config comes from bw at run time; none is rendered into this script.
# WIREGUARD_DRY_RUN=1 prints the privileged steps instead of running them.
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
note={{ printf "wireguard-%s" .chezmoi.hostname | quote }}
run() { if [ "${WIREGUARD_DRY_RUN:-}" = 1 ]; then echo "dry-run: $*"; else "$@"; fi; }

{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
dir="$HOMEBREW_PREFIX/etc/wireguard"
# wg-quick needs bash >= 4; sudo resets PATH to /bin/bash 3.2.
wg_quick=(sudo "$HOMEBREW_PREFIX/bin/bash" "$HOMEBREW_PREFIX/bin/wg-quick")
if [ -d /Applications/WireGuard.app ]; then
  echo "wireguard: WireGuard.app manages the tunnel here; skipping"
  exit 0
fi
{{- else -}}
dir=/etc/wireguard
wg_quick=(sudo wg-quick)
{{- end }}

config="$(bw get item "$note" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("notes") or "", end="")' || true)"
if [ -z "$config" ]; then
  echo "wireguard: no locker note $note; skipping"
  exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
chmod 600 "$tmp"
printf '%s\n' "$config" > "$tmp"

if ! sudo -n cmp -s "$tmp" "$dir/wg0.conf" 2>/dev/null; then
  run sudo install -d -m 700 "$dir"
  run sudo install -m 600 "$tmp" "$dir/wg0.conf"
  echo "wireguard: wrote $dir/wg0.conf"
fi

if [ -z "$(sudo -n wg show interfaces 2>/dev/null || true)" ]; then
  run "${wg_quick[@]}" up wg0
fi
{{ if eq .chezmoi.os "linux" -}}
run sudo systemctl enable wg-quick@wg0
{{ end -}}
{{ end -}}
