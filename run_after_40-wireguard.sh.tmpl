{{- if env "BW_SESSION" -}}
#!/bin/bash
# Secrets pass: WireGuard tunnels from locker, per machine.
#   jesseearle <- note wireguard-jesseearle-<hostname>  (personal VPN)
#   odva       <- note wireguard-odva-<hostname>        (odva network)
# Configs come from bw at run time; none is rendered into this script.
# WIREGUARD_DRY_RUN=1 prints the privileged steps instead of running them.
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
host={{ .chezmoi.hostname | quote }}
run() { if [ "${WIREGUARD_DRY_RUN:-}" = 1 ]; then echo "dry-run: $*"; else "$@"; fi; }

{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
dir="$HOMEBREW_PREFIX/etc/wireguard"
import_dir={{ printf "%s/.config/wireguard" .chezmoi.destDir | quote }}
# wg-quick needs bash >= 4; sudo resets PATH to /bin/bash 3.2.
wg_quick=(sudo "$HOMEBREW_PREFIX/bin/bash" "$HOMEBREW_PREFIX/bin/wg-quick")
has_address() { ifconfig | grep "inet ${1%/*} " >/dev/null; }
# Any tunnel imported in WireGuard.app: the app runs this machine's tunnels
# (names there may differ, e.g. cold-forge's "jesse-laptop").
app_managed() { scutil --nc list 2>/dev/null | grep 'com\.wireguard\.macos' >/dev/null; }
# Boot start for wg-quick tunnels, unless a daemon already runs this one.
# wg knows macOS tunnels only as utunN; wg-quick maps names in <name>.name.
boot_daemon() {
  local iface="$1" label="com.jesseearle.wireguard.$1"
  local plist="/Library/LaunchDaemons/$label.plist" tmp
  if grep -l -s "wg-quick up $iface" /Library/LaunchDaemons/*.plist | grep -v "^$plist$" >/dev/null; then
    echo "wireguard: $iface: boot daemon exists already"
    return 0
  fi
  tmp="$(mktemp)"
  cat > "$tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string><string>-c</string>
    <string>$HOMEBREW_PREFIX/bin/wg show "\$(cat /var/run/wireguard/$iface.name 2&gt;/dev/null)" &gt;/dev/null 2&gt;&amp;1 || exec $HOMEBREW_PREFIX/bin/bash $HOMEBREW_PREFIX/bin/wg-quick up $iface</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>$HOMEBREW_PREFIX/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <!-- At boot DNS may not resolve the endpoint yet: retry until up. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardErrorPath</key><string>/var/log/$label.log</string>
</dict>
</plist>
PLIST
  if ! sudo -n cmp -s "$tmp" "$plist" 2>/dev/null; then
    run sudo install -m 644 -o root -g wheel "$tmp" "$plist"
    echo "wireguard: $iface: boot daemon installed"
  fi
  rm -f "$tmp"
}
{{- else -}}
dir=/etc/wireguard
wg_quick=(sudo wg-quick)
has_address() { ip -4 addr | grep "inet ${1%/*}/" >/dev/null; }
app_managed() { false; }
boot_daemon() { run sudo systemctl enable "wg-quick@$1"; }
{{- end }}

# Exact name match: bw get item matches by substring.
note_text() {
  bw list items --search "$1" 2>/dev/null \
    | python3 -c '
import json, sys
name = sys.argv[1]
item = next((i for i in json.load(sys.stdin) if i["name"] == name), {})
print(item.get("notes") or "", end="")' "$1" 2>/dev/null \
    || true
}

tunnel() {
  local iface="$1" note="$2" config address tmp
  config="$(note_text "$note")"
  if [ -z "$config" ]; then
    echo "wireguard: $iface: no locker note $note; skipping"
    return 0
  fi

  tmp="$(mktemp)"
  chmod 600 "$tmp"
  printf '%s\n' "$config" > "$tmp"
{{- if eq .chezmoi.os "darwin" }}

  # Your own copy for WireGuard.app's "Import tunnel(s) from file".
  mkdir -p "$import_dir"
  chmod 700 "$import_dir"
  if ! cmp -s "$tmp" "$import_dir/$iface.conf"; then
    install -m 600 "$tmp" "$import_dir/$iface.conf"
    echo "wireguard: $iface: wrote $import_dir/$iface.conf (for WireGuard.app import)"
  fi
{{- end }}
  if ! sudo -n cmp -s "$tmp" "$dir/$iface.conf" 2>/dev/null; then
    run sudo install -d -m 700 "$dir"
    run sudo install -m 600 "$tmp" "$dir/$iface.conf"
    echo "wireguard: $iface: wrote $dir/$iface.conf"
  fi
  rm -f "$tmp"

  # Up only when no interface has this address yet (app or another name).
  address="$(printf '%s\n' "$config" | sed -n 's/^Address *= *\([^,]*\).*/\1/p' | head -n 1)"
  if app_managed "$iface"; then
    echo "wireguard: $iface: WireGuard.app runs this machine's tunnels; config written only"
    return 0
  fi
  if [ -n "$address" ] && has_address "$address"; then
    echo "wireguard: $iface: ${address%/*} already up; left running"
  else
    run "${wg_quick[@]}" up "$iface"
    echo "wireguard: $iface: up"
  fi
  boot_daemon "$iface"
}

tunnel jesseearle "wireguard-jesseearle-$host"
tunnel odva "wireguard-odva-$host"
{{- if eq .chezmoi.os "darwin" }}

# After a network change, keep each tunnel's off-link ranges routed through it
# (home LAN via the tunnel away from home, direct at home).
if ! app_managed; then
  fixer="$dir/wg-routes.py"
  if ! sudo -n cmp -s {{ printf "%s/libexec/wg-routes.py" .chezmoi.sourceDir | quote }} "$fixer" 2>/dev/null; then
    run sudo install -m 755 -o root -g wheel {{ printf "%s/libexec/wg-routes.py" .chezmoi.sourceDir | quote }} "$fixer"
  fi
  label=com.jesseearle.wireguard.routes
  plist="/Library/LaunchDaemons/$label.plist"
  tmp="$(mktemp)"
  cat > "$tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>$fixer</string></array>
  <key>WatchPaths</key>
  <array><string>/Library/Preferences/SystemConfiguration</string><string>/etc/resolv.conf</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/var/log/$label.log</string>
  <key>StandardErrorPath</key><string>/var/log/$label.log</string>
</dict>
</plist>
PLIST
  if ! sudo -n cmp -s "$tmp" "$plist" 2>/dev/null; then
    run sudo install -m 644 -o root -g wheel "$tmp" "$plist"
    run sudo launchctl bootout system "$plist" 2>/dev/null || true
    run sudo launchctl bootstrap system "$plist"
    echo "wireguard: route hook installed"
  fi
  rm -f "$tmp"
fi
{{- end }}
{{ end -}}
