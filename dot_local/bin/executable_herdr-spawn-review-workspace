#!/usr/bin/env bash
set -euo pipefail

DIR="${1:-$PWD}"
LABEL="${2:-$(basename "$DIR")}"

LOG_DIR="${HERDR_REVIEW_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr/review-launches}"
mkdir -p "$LOG_DIR"
LOG_FILE=$(mktemp "$LOG_DIR/launch.XXXXXXXX")
exec 2> >(tee -a "$LOG_FILE" >&2)
printf 'Review workspace launch log: %s\n' "$LOG_FILE" >&2

PIDS=()
LAUNCH_LABELS=()
finish() {
  local status=$? index
  trap - EXIT
  for ((index=0; index<${#PIDS[@]}; index++)); do
    if ! wait "${PIDS[$index]}"; then
      printf 'Agent launch failed: %s (log: %s)\n' "${LAUNCH_LABELS[$index]}" "$LOG_FILE" >&2
      status=1
    fi
  done
  if (( status != 0 )); then
    printf 'Review workspace launch incomplete; see %s\n' "$LOG_FILE" >&2
  fi
  exit "$status"
}
trap finish EXIT

read_id() {
  local field="$1" value
  if ! value=$(/usr/bin/jq -er "$field | select(type == \"string\" and length > 0)"); then
    printf 'Missing or invalid Herdr ID: %s\n' "$field" >&2
    return 1
  fi
  printf '%s\n' "$value"
}

HERDR_CMD=(herdr)
if [[ -n "${HERDR_SESSION:-}" ]]; then
  HERDR_CMD=(herdr --session "$HERDR_SESSION")
fi

if [[ "${HERDR_REVIEW_SKIP_TRUST:-0}" != 1 && -f ~/.claude.json ]]; then
  node - "$HOME/.claude.json" "$DIR" <<'NODE'
    const fs = require('fs');
    const [p, dir] = process.argv.slice(2);
    try {
      const d = JSON.parse(fs.readFileSync(p, 'utf8'));
      d.projects = d.projects || {};
      d.projects[dir] = d.projects[dir] || {};
      d.projects[dir].hasTrustDialogAccepted = true;
      fs.writeFileSync(p, JSON.stringify(d, null, 2));
    } catch(e) { console.error('Could not update Claude project trust:', e.message); }
NODE
fi

WS_JSON=$("${HERDR_CMD[@]}" workspace create --label "$LABEL" --cwd "$DIR" --focus)
WS_ID=$(printf '%s\n' "$WS_JSON" | read_id '.result.workspace.workspace_id')
# Preserve case distinctions in opaque workspace IDs using lowercase hex.
AGENT_PREFIX="ws-$(printf '%s' "$WS_ID" | od -An -tx1 | tr -d ' \n')"
if (( ${#AGENT_PREFIX} + 5 > 32 )); then
  printf 'Workspace ID too long for unique agent names: %s\n' "$WS_ID" >&2
  exit 1
fi

TAB1_ID=$("${HERDR_CMD[@]}" tab list --workspace "$WS_ID" | read_id '.result.tabs[0].tab_id')
"${HERDR_CMD[@]}" tab rename "$TAB1_ID" folder

wait_and_start() {
  local agent_name="$1"
  local agent_kind="$2"
  local pane_id="$3"
  shift 3

  local attempts=0
  while (( attempts < 30 )); do
    local text
    text=$("${HERDR_CMD[@]}" pane read "$pane_id" --source detection 2>/dev/null || true)
    if [[ "$text" =~ (❯|\$|\%|\>)[[:space:]]*$ ]]; then
      break
    fi
    sleep 0.2
    attempts=$((attempts + 1))
  done

  "${HERDR_CMD[@]}" agent start "$agent_name" --kind "$agent_kind" --pane "$pane_id" -- "$@"
}

create_tab_async() {
  local tab_label="$1"
  local agent_suffix="$2"
  local agent_kind="$3"
  local identity="Your identity: name=$1 make=$4 model=$5 version=$6. Wait for instructions."
  shift 6
  # Claude takes the identity as a system prompt so launch does not start a turn.
  # Original (Claude answers the identity as a first message):
  # if [[ "$agent_kind" == agy ]]; then set -- "$@" -i "$identity"; else set -- "$@" "$identity"; fi
  if [[ "$agent_kind" == agy ]]; then set -- "$@" -i "$identity"; elif [[ "$agent_kind" == claude ]]; then set -- "$@" --append-system-prompt "$identity"; else set -- "$@" "$identity"; fi

  local tab_json pane_id
  tab_json=$("${HERDR_CMD[@]}" tab create --workspace "$WS_ID" --label "$tab_label" --cwd "$DIR")
  pane_id=$(printf '%s\n' "$tab_json" | read_id '.result.root_pane.pane_id')

  wait_and_start "${AGENT_PREFIX}-${agent_suffix}" "$agent_kind" "$pane_id" "$@" &
  PIDS+=("$!")
  LAUNCH_LABELS+=("$tab_label / ${AGENT_PREFIX}-${agent_suffix}")
}

# Alignment (Persistent memory across turns)
create_tab_async "align1" "align1" claude Anthropic opus 5.5    --model "claude-opus-5-5" --effort low

# Executors (Opus primary -> Sonnet fast/secondary)
create_tab_async "exec1"  "exec1"  claude Anthropic opus 5.5    --model "claude-opus-5-5" --effort low
create_tab_async "exec2"  "exec2"  claude Anthropic sonnet 5.5  --model "claude-sonnet-5-5" --effort low

# Reviewers (Lean orthogonal fleet)
create_tab_async "rev1"   "rev1"   claude Anthropic haiku 5.5   --model "claude-haiku-5-5" --effort low
create_tab_async "rev2"   "rev2"   agy Google flash 3.8         --model "gemini-3.8-flash" --effort low
create_tab_async "rev3"   "rev3"   agy Google argon 4           --model "gemini-4-argon"   --effort low
create_tab_async "rev4"   "rev4"   codex OpenAI sol 6.1         -m "gpt-6.1-sol" -c model_reasoning_effort="low"
create_tab_async "rev5"   "rev5"   codex OpenAI astra 6         -m "gpt-6-astra" -c model_reasoning_effort="low"
create_tab_async "rev6"   "rev6"   grok xAI grok 4.7            -m "grok-4.7" --reasoning-effort low


# The EXIT trap collects every background launch, including after setup errors.
